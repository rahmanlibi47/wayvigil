<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SafeRouteAI" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/purple_500</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <style name="Theme.SafeRouteAI.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/purple_500</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SafeRouteAI</item>
    </style>
</resources>
