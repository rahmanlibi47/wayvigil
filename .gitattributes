# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text eol=lf
*.pyx text eol=lf
*.pxd text eol=lf

# Kotlin files
*.kt text eol=lf
*.kts text eol=lf

# Gradle files
*.gradle text eol=lf
gradlew text eol=lf
*.properties text eol=lf

# YAML/XML/JSON
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.json text eol=lf

# Markdown
*.md text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows batch files (keep CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar.gz binary
*.db binary
